# ── Server ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Security ──────────────────────────────────────────────
# Ganti dengan key yang kuat dan unik!
API_KEY=changeme-api-key-amhub-2024

# ── WhatsApp ──────────────────────────────────────────────
# Path folder untuk menyimpan session Baileys
WA_SESSION_PATH=./auth_info_baileys
# Interval reconnect dalam milidetik (default: 5 detik)
WA_RECONNECT_INTERVAL=5000

# ── Blast Settings ────────────────────────────────────────
# Jeda antar pesan dalam milidetik (default: 3 detik)
# Rekomendasi: min 2000ms untuk menghindari ban WA
BLAST_DEFAULT_DELAY_MS=3000
BLAST_MIN_DELAY_MS=2000
BLAST_MAX_DELAY_MS=10000

# ── Database ──────────────────────────────────────────────
DB_PATH=./data/amhub.db

# ── Supabase Cloud Session Storage (Optional for Render.com Persistence) ─
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# ── CORS ──────────────────────────────────────────────────
# Ganti dengan URL AM Hub kamu (Google Apps Script Web App URL)
# Gunakan * untuk development (izinkan semua origin)
AMHUB_ORIGIN=*
